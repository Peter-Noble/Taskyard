FROM ubuntu:24.04

ARG RUSTDESK_VERSION=1.3.6

RUN apt-get update && apt-get install -y \
    git curl wget ca-certificates \
    python3 python3-pip python3-venv \
    nodejs npm \
    rustc cargo \
    xvfb fluxbox \
    libgtk-3-0 libxcb-randr0 libxdo3 libxfixes3 libxcb-shape0 libxcb-xfixes0 \
    libasound2t64 libpulse0 \
    && rm -rf /var/lib/apt/lists/*

# RustDesk client for remote desktop preview (replaces legacy x11vnc stack)
RUN curl -fsSL "https://github.com/rustdesk/rustdesk/releases/download/${RUSTDESK_VERSION}/rustdesk-${RUSTDESK_VERSION}-x86_64.deb" \
    -o /tmp/rustdesk.deb \
    && apt-get update \
    && apt-get install -y /tmp/rustdesk.deb \
    && rm -f /tmp/rustdesk.deb \
    && rm -rf /var/lib/apt/lists/*

# Common agent tooling
RUN pip3 install --break-system-packages openai
RUN npm install -g tsx typescript
RUN cd / && npm install @cursor/sdk

ENV DISPLAY=:99
EXPOSE 21116 8080

CMD ["bash"]
