{
  "name": "taskyard",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:server": "pnpm --filter @taskyard/protocol build && pnpm --filter @taskyard/db build && pnpm --filter @taskyard/core build && pnpm db:sync-sandbox && pnpm --filter server dev",
    "dev:hub": "pnpm --filter hub dev",
    "dev:worker": "pnpm --filter cli dev:worker",
    "dev:tui": "pnpm --filter cli dev:tui",
    "build": "pnpm -r build",
    "db:push": "pnpm --filter db push",
    "db:migrate-mvp": "pnpm --filter db migrate-mvp",
    "pretest": "pnpm --filter @taskyard/protocol build && pnpm --filter @taskyard/db build && pnpm --filter @taskyard/test-utils build && pnpm --filter @taskyard/core build",
    "test": "vitest run",
    "test:unit": "vitest run packages/**/*.unit.test.ts apps/**/*.unit.test.ts",
    "test:integration": "vitest run packages/**/*.integration.test.ts apps/**/*.integration.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:sync-sandbox": "pnpm --filter @taskyard/db exec node ./scripts/sync-sandbox-db.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^7.0.3",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  }
}
